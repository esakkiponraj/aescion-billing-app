# AESCION Commerce Environment Configuration Example

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL 18)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/aescion_commerce?schema=public"

# Authentication & JWT
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"
JWT_EXPIRATION="1d"
JWT_REFRESH_SECRET="replace_with_a_secure_random_refresh_secret_key"
JWT_REFRESH_EXPIRATION="7d"

# Realtime / WebSockets
SOCKET_PORT=4000

# Offline Sync Policy
OFFLINE_AUTH_MAX_DAYS=3
